# Copy to .env in this folder and fill in secrets.
# Do not commit .env. All paths below are placeholders — set to your local layout.

# ===== LLM API (parse + multimodal generate) =====
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_API_MODE=chat
OPENAI_API_KEY=
OPENAI_MODEL_NAME=qwen3.7-plus
DISABLE_THINKING=true
OPENAI_TEMPERATURE=0.7
OPENAI_MAX_TOKENS=4096
OPENAI_TOP_P=0.8
API_BATCH_CONCURRENT=4
API_REQUEST_DELAY=0.5
API_MAX_RETRIES=3

# LLM API cache (stage 01 + 04)
ENABLE_LLM_API_CACHE=true
BATCH_EVAL_LLM_CACHE_DIR=./api_llm_cache

# Stage 05 reflection agent
ENABLE_REFLECTION=true
MAX_REFLECTIONS=2
USE_LLM_REFLECTION=true
REFLECT_CHUNK_TOP_K=100
REFLECT_MIN_RR_CHUNKS=0.5
REFLECT_MIN_RR_RELATIONS=0.3

REQUIRE_QUESTION_IMAGES=true
INCLUDE_RETRIEVED_IMAGES=false
QUESTION_IMAGE_MAX_PIXELS=1048576
RETRIEVED_IMAGE_MAX_PIXELS=65536

# ===== GPU stage 02 (embedding + Virchow2 + rerank) =====
GPU_BATCH_CONCURRENT=1
EMBEDDING_FUNC_MAX_ASYNC=1
EMBEDDING_METHOD=direct
EMBEDDING_MODEL_PATH=./models/bge-m3
EMBEDDING_DIM=1024
VIRCHOW2_MODEL_PATH=./models/Virchow2
RERANK_METHOD=local
RERANK_MODEL_PATH=./models/Qwen3-Reranker-8B
RERANK_BATCH_SIZE=32
RERANK_PAIR_CHUNK_SIZE=16
RERANK_MAX_DOC_CHARS=4000
ENABLE_RERANK=true
RETRIEVE_SIMILAR_IMAGES=1
IMAGE_TOP_K_PER_IMAGE=10
PATHOLOGY_IMAGES_COSINE_BETTER_THAN_THRESHOLD=0.6

TOP_K=100
CHUNK_TOP_K=30
MIN_RERANK_SCORE=0.25
COSINE_BETTER_THAN_THRESHOLD=0.35
RELATION_ENTITY_IOU_THRESHOLD=0.2

# ===== PostgreSQL + RAG storage =====
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DATABASE=
GRAPH_STORAGE=PGHypergraphStorage
VECTOR_STORAGE=PGVectorStorage
WORKING_DIR=./pathpocket_storage
PATHRETRIEVAL_MEDIA_ROOT=.

# Cross-machine image path remapping (optional)
# IMAGE_PATH_PREFIX_FROM=/path/on/machine_a
# IMAGE_PATH_PREFIX_TO=/path/on/machine_b
# IMAGE_PATH_PREFIX_MAP=/from1:/to1,/from2:/to2

# Evidence catalog (bundled under data/)
EVIDENCE_LEVEL_TITLE_CATEGORY_JSON=./data/evidence_level_title_category.slim.json
# EVIDENCE_LEVEL_MAP_PATH=./data/evidence_level_map.json

PIPELINE_LANGUAGE=en
BATCH_EVAL_OUTPUT_DIR=./runs
